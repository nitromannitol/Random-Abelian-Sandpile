import RandomSandpile.Defs.Lattice

/-!
# The random environment (Section 1.2)

`paper/random_piles-corrected.tex`. The paper's sample space `Ω` is the set of
bounded functions `ℤ^d → ℤ` with the σ-algebra generated by the coordinate maps `η ↦ η(x)`. We take
`Config d = ℤ^d → ℤ` with the product σ-algebra (`MeasurableSpace.pi`, `ℤ` discrete), which is the
σ-algebra generated by the coordinate maps; boundedness is the almost sure property
`RandomEnvironment.bounded` instead of a restriction of the sample space.

The translation `T_y η(z) = η(y + z)` is `shift y`. It satisfies `T_{y+z} = T_y ∘ T_z`
(`shift_add`), the composition law required by Lattice-Probability's Akcoglu–Krengel theorem
`LatticeProb.akcoglu_krengel` (`LatticeProb/Prob/AkcogluKrengelAE/Assembly.lean`).
-/

noncomputable section

open MeasureTheory LatticeProb

namespace RandomSandpile

variable {d : ℕ}

/-- A configuration (initial sandpile) `η : ℤ^d → ℤ`, with the product σ-algebra generated by the
coordinate maps. -/
abbrev Config (d : ℕ) : Type := Site d → ℤ

/-- The translation `T_y η(z) = η(y + z)`. -/
def shift (y : Site d) (η : Config d) : Config d := fun z => η (y + z)

@[simp] theorem shift_apply (y : Site d) (η : Config d) (z : Site d) : shift y η z = η (y + z) :=
  rfl

theorem shift_zero : shift (0 : Site d) = id := by
  funext η z; simp [shift]

/-- `T_{y+z} = T_y ∘ T_z`. -/
theorem shift_add (y z : Site d) (η : Config d) : shift (y + z) η = shift y (shift z η) := by
  funext w; simp only [shift]; congr 1; abel

theorem measurable_shift (y : Site d) : Measurable (shift y : Config d → Config d) :=
  measurable_pi_lambda _ fun z => measurable_pi_apply (y + z)

/-- A *random environment*: a probability measure `P` on configurations which is

* uniformly bounded: `P[η_min ≤ η(x) ≤ η_max] = 1` for every `x`;
* stationary: `P(T_y E) = P(E)` for every event `E` and `y ∈ ℤ^d`. Since `T_y` is a
  bijection with inverse `T_{-y}`, `T_y E = T_{-y}⁻¹(E)`, so this is `MeasurePreserving (shift y)`
  for every `y`;
* ergodic: `E = ⋂_y T_y E` implies `P(E) ∈ {0, 1}`. Taking `y = 0` and `-y` shows
  that `E = ⋂_y T_y E` holds exactly when `T_y E = E` for all `y`, that is, when
  `shift y ⁻¹' E = E` for all `y`.

Neither `d ≥ 2` nor high density is part of the structure: they are hypotheses of the statements
that use them. -/
structure RandomEnvironment (d : ℕ) where
  /-- The law `P` of the initial sandpile. -/
  P : Measure (Config d)
  /-- `P` is a probability measure. -/
  [isProb : IsProbabilityMeasure P]
  /-- The lower bound `η_min`. -/
  ηmin : ℤ
  /-- The upper bound `η_max`. -/
  ηmax : ℤ
  /-- Uniform boundedness. -/
  bounded : ∀ x : Site d, ∀ᵐ η ∂P, ηmin ≤ η x ∧ η x ≤ ηmax
  /-- Stationarity. -/
  stationary : ∀ y : Site d, MeasurePreserving (shift y) P P
  /-- Ergodicity. -/
  ergodic : ∀ S : Set (Config d), MeasurableSet S → (∀ y : Site d, shift y ⁻¹' S = S) →
    P S = 0 ∨ P S = 1

attribute [instance] RandomEnvironment.isProb

/-- The mean density `E(η(0))`. -/
def meanEta (P : Measure (Config d)) : ℝ := ∫ η, (η 0 : ℝ) ∂P

/-- *High density* `E(η(0)) > 2d - 1`. -/
def HighDensity (P : Measure (Config d)) : Prop := 2 * (d : ℝ) - 1 < meanEta P

end RandomSandpile
