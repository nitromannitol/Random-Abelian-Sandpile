import RandomSandpile.Defs.Green

/-!
# The random divisible sandpile (Section 8)

`paper/random_piles-corrected.tex`: the divisible sandpile on a finite set
`V ⊆ ℤ^d`, its least action principle (Proposition 8.1, Levine-Peres), the real
random environment of Section 8.2, the odometers `v_n`, `v_{avg_n}` on
`W_n = ℤ^d ∩ nW` and the rescaling `v̄_n(x) = n⁻² v_n([nx])` on `n⁻¹ W̄_n` of Theorem 8.2
.

## The dynamics and the normalisation of the odometer

A configuration is `σ : ℤ^d → ℝ`. A site `x ∈ V` is unstable when `σ(x) > 1`; toppling it keeps
mass `1` at `x` and distributes the excess `σ(x) - 1` equally among the `2d` neighbours of `x`
(which prints the excess as `1 - η(x)`). Sites off `V` never topple: they are sinks,
and the mass they receive leaves the system. We run the *parallel* toppling procedure, in which
every unstable site of `V` topples at every round (`divTopple`), one legal toppling procedure in
the sense of Levine-Peres; its configurations are `divConfig V η k`.

The paper says the odometer "counts the total mass emitted by each site" but states the
least action principle as `v = min{f : V̄ → ℝ⁺ : Δ_{ℤ^d} f + η ≤ 1}` with the
unnormalised Laplacian `Δ_{ℤ^d} f(x) = ∑_{y ∼ x}(f(y) - f(x))` (`lapR`), and Theorem 8.2's proof
uses `Δ_{ℤ^d} v_n + η ≤ 1`. If `u` is the total emitted mass, the final configuration
is `η + (2d)⁻¹ Δ_{ℤ^d} u`, so the formula of Proposition 8.1 holds for `v = u / (2d)`, the mass
emitted to *each neighbour*. We follow the formulas: `divOdometer V η` is the mass emitted by each
site to each of its neighbours, so that `divConfig V η k = η + Δ_{ℤ^d} (divOdometerUpTo V η k)`
(`divConfig_eq`). This is also the normalisation of Lattice-Probability's whole-space divisible
sandpile `LatticeProb.Graph.odometer` (per-neighbour `LatticeProb.Graph.emission`,
`LatticeProb/Graph/Basic.lean`), which cannot be reused here because it has no sinks. The
statement of Theorem 8.2 is unchanged by the factor `2d`, which multiplies `v_n` and `v_{avg_n}`
alike.

## The least action principle is not definitional

`divOdometer` is defined by the dynamics, and `divLeastAction` is the pointwise infimum of the class
`divLeastActionSet` of Proposition 8.1. Proposition 8.1 (Levine-Peres) is the statement that for
finite `V` the dynamics stabilizes and the odometer is the least element of that class,
`IsLeast (divLeastActionSet V η) (divOdometer V η)`; then `divLeastAction V η = divOdometer V η`
(`divLeastAction_eq_of_isLeast`). The class asks `f ≥ 0` on all of `ℤ^d` rather than on
`V̄ = V ∪ ∂V` only: the constraint `Δ_{ℤ^d} f + η ≤ 1` is imposed on `V` and reads only `f` on `V̄`,
so the two classes have the same restrictions to `V̄`, and the extra values are `0` at the least
element (as is the odometer off `V`, `divOdometer_eq_zero_of_not_mem`).
-/

noncomputable section

open MeasureTheory LatticeProb Filter Topology

namespace RandomSandpile

variable {d : ℕ}

/-! ### Linearity of the discrete Laplacian -/

theorem lapR_add (f g : Site d → ℝ) (x : Site d) :
    lapR (fun z => f z + g z) x = lapR f x + lapR g x := by
  simp only [lapR, nbrSum, Finset.sum_add_distrib]
  ring

theorem lapR_zero (x : Site d) : lapR (fun _ => (0 : ℝ)) x = 0 := by
  simp [lapR, nbrSum]

/-! ### The real random environment -/

/-- A real configuration `η : ℤ^d → ℝ`. -/
abbrev RealConfig (d : ℕ) : Type := Site d → ℝ

/-- The translation `T_y η(z) = η(y + z)` of a real configuration. -/
def shiftReal (y : Site d) (η : RealConfig d) : RealConfig d := fun z => η (y + z)

@[simp] theorem shiftReal_apply (y : Site d) (η : RealConfig d) (z : Site d) :
    shiftReal y η z = η (y + z) :=
  rfl

theorem shiftReal_zero : shiftReal (0 : Site d) = id := by
  funext η z; simp [shiftReal]

/-- `T_{y+z} = T_y ∘ T_z`. -/
theorem shiftReal_add (y z : Site d) (η : RealConfig d) :
    shiftReal (y + z) η = shiftReal y (shiftReal z η) := by
  funext w; simp only [shiftReal]; congr 1; abel

theorem measurable_shiftReal (y : Site d) :
    Measurable (shiftReal y : RealConfig d → RealConfig d) :=
  measurable_pi_lambda _ fun z => measurable_pi_apply (y + z)

/-- A *real random environment*, the setting of Section 8.2: a probability measure
`P` on real configurations `ℤ^d → ℝ` (product σ-algebra, generated by the coordinate maps) which is

* uniformly bounded: `P[η_min ≤ η(x) ≤ η_max] = 1` for every `x`, with real `η_min, η_max`; this replaces the sample space of bounded backgrounds, as in
  `RandomEnvironment`;
* stationary and ergodic for the translations `T_y`, with the same formulation as
  `RandomEnvironment`.

High density is not assumed. -/
structure RealRandomEnvironment (d : ℕ) where
  /-- The law `P` of the initial divisible sandpile. -/
  P : Measure (RealConfig d)
  /-- `P` is a probability measure. -/
  [isProb : IsProbabilityMeasure P]
  /-- The lower bound `η_min`. -/
  ηmin : ℝ
  /-- The upper bound `η_max`. -/
  ηmax : ℝ
  /-- Uniform boundedness. -/
  bounded : ∀ x : Site d, ∀ᵐ η ∂P, ηmin ≤ η x ∧ η x ≤ ηmax
  /-- Stationarity (218-220). -/
  stationary : ∀ y : Site d, MeasurePreserving (shiftReal y) P P
  /-- Ergodicity (221-223). -/
  ergodic : ∀ S : Set (RealConfig d), MeasurableSet S → (∀ y : Site d, shiftReal y ⁻¹' S = S) →
    P S = 0 ∨ P S = 1

attribute [instance] RealRandomEnvironment.isProb

/-- The mean density `η_avg = E η(0)` of a real environment. -/
def meanEtaReal (P : Measure (RealConfig d)) : ℝ := ∫ η, η 0 ∂P

/-! ### The divisible sandpile on a set with sinks -/

/-- The mass `(σ(x) - 1)⁺ / (2d)` that a site `x ∈ V` sends to each of its `2d` neighbours in one
round of parallel toppling of `σ`; it is `0` at stable sites and at the sinks `x ∉ V`. -/
def divEmission (V : Set (Site d)) (σ : Site d → ℝ) : Site d → ℝ :=
  V.indicator fun x => max (σ x - 1) 0 / (2 * d)

/-- One round of parallel toppling in `V`: every unstable site of `V` keeps mass `1` and sends its
excess, equally split, to its `2d` neighbours; `σ ↦ σ + Δ_{ℤ^d} e`, `e = divEmission V σ`. -/
def divTopple (V : Set (Site d)) (σ : Site d → ℝ) : Site d → ℝ :=
  fun x => σ x + lapR (divEmission V σ) x

/-- The configuration `σ_k` after `k` rounds of parallel toppling in `V`, started from `η`. -/
def divConfig (V : Set (Site d)) (η : Site d → ℝ) (k : ℕ) : Site d → ℝ :=
  (divTopple V)^[k] η

/-- The odometer after `k` rounds, `v_k(x) = ∑_{j<k} (σ_j(x) - 1)⁺ 1_V(x) / (2d)`: the mass sent
by `x` to each neighbour during the first `k` rounds. -/
def divOdometerUpTo (V : Set (Site d)) (η : Site d → ℝ) (k : ℕ) (x : Site d) : ℝ :=
  ∑ j ∈ Finset.range k, divEmission V (divConfig V η j) x

/-- The divisible sandpile `η` *stabilizes* in `V`: at every site the nondecreasing sequence
`k ↦ v_k(x)` is bounded, hence convergent (`tendsto_divOdometerUpTo`). -/
def DivStabilizes (V : Set (Site d)) (η : Site d → ℝ) : Prop :=
  ∀ x : Site d, BddAbove (Set.range fun k => divOdometerUpTo V η k x)

/-- **The divisible sandpile odometer** of `η` in `V`, `v = lim_k v_k = sup_k v_k`, the
mass emitted by each site to each of its neighbours under parallel toppling with sinks off `V`
(see the module docstring for the normalisation). When `η` stabilizes in `V` it is the limit of
`divOdometerUpTo V η k` (`tendsto_divOdometerUpTo`). Proposition 8.1 identifies it with the least
element of `divLeastActionSet V η`. -/
def divOdometer (V : Set (Site d)) (η : Site d → ℝ) (x : Site d) : ℝ :=
  ⨆ k : ℕ, divOdometerUpTo V η k x

theorem divEmission_nonneg (V : Set (Site d)) (σ : Site d → ℝ) (x : Site d) :
    0 ≤ divEmission V σ x :=
  Set.indicator_nonneg (fun _ _ => div_nonneg (le_max_right _ _) (by positivity)) x

theorem divEmission_eq_zero_of_not_mem (V : Set (Site d)) (σ : Site d → ℝ) {x : Site d}
    (hx : x ∉ V) : divEmission V σ x = 0 :=
  Set.indicator_of_notMem hx _

theorem divConfig_zero (V : Set (Site d)) (η : Site d → ℝ) : divConfig V η 0 = η := rfl

theorem divConfig_succ (V : Set (Site d)) (η : Site d → ℝ) (k : ℕ) :
    divConfig V η (k + 1) = divTopple V (divConfig V η k) :=
  Function.iterate_succ_apply' _ _ _

theorem divOdometerUpTo_succ (V : Set (Site d)) (η : Site d → ℝ) (k : ℕ) (x : Site d) :
    divOdometerUpTo V η (k + 1) x
      = divOdometerUpTo V η k x + divEmission V (divConfig V η k) x :=
  Finset.sum_range_succ _ _

theorem divOdometerUpTo_nonneg (V : Set (Site d)) (η : Site d → ℝ) (k : ℕ) (x : Site d) :
    0 ≤ divOdometerUpTo V η k x :=
  Finset.sum_nonneg fun _ _ => divEmission_nonneg _ _ _

theorem divOdometerUpTo_mono (V : Set (Site d)) (η : Site d → ℝ) (x : Site d) :
    Monotone fun k => divOdometerUpTo V η k x :=
  monotone_nat_of_le_succ fun k => by
    rw [divOdometerUpTo_succ]
    exact le_add_of_nonneg_right (divEmission_nonneg _ _ _)

theorem divOdometerUpTo_eq_zero_of_not_mem (V : Set (Site d)) (η : Site d → ℝ) (k : ℕ)
    {x : Site d} (hx : x ∉ V) : divOdometerUpTo V η k x = 0 :=
  Finset.sum_eq_zero fun _ _ => divEmission_eq_zero_of_not_mem _ _ hx

/-- **Conservation of mass**: after `k` rounds the configuration is `η + Δ_{ℤ^d} v_k`. -/
theorem divConfig_eq (V : Set (Site d)) (η : Site d → ℝ) (k : ℕ) (x : Site d) :
    divConfig V η k x = η x + lapR (divOdometerUpTo V η k) x := by
  induction k generalizing x with
  | zero =>
      have h0 : divOdometerUpTo V η 0 = fun _ => 0 := funext fun _ => Finset.sum_range_zero _
      rw [divConfig_zero, h0, lapR_zero, add_zero]
  | succ k ih =>
      have hk : divOdometerUpTo V η (k + 1)
          = fun z => divOdometerUpTo V η k z + divEmission V (divConfig V η k) z :=
        funext fun z => divOdometerUpTo_succ V η k z
      rw [divConfig_succ, divTopple, ih, hk, lapR_add]
      ring

theorem divOdometer_nonneg (V : Set (Site d)) (η : Site d → ℝ) (x : Site d) :
    0 ≤ divOdometer V η x :=
  Real.iSup_nonneg fun k => divOdometerUpTo_nonneg V η k x

/-- The odometer vanishes at the sinks. -/
theorem divOdometer_eq_zero_of_not_mem (V : Set (Site d)) (η : Site d → ℝ) {x : Site d}
    (hx : x ∉ V) : divOdometer V η x = 0 := by
  simp only [divOdometer, divOdometerUpTo_eq_zero_of_not_mem V η _ hx, ciSup_const]

theorem tendsto_divOdometerUpTo {V : Set (Site d)} {η : Site d → ℝ} (h : DivStabilizes V η)
    (x : Site d) :
    Tendsto (fun k => divOdometerUpTo V η k x) atTop (𝓝 (divOdometer V η x)) :=
  tendsto_atTop_ciSup (divOdometerUpTo_mono V η x) (h x)

/-! ### The least action principle (Proposition 8.1) -/

/-- The class `{f ≥ 0 : Δ_{ℤ^d} f + η ≤ 1 in V}` of Proposition 8.1, the
supersolutions of the obstacle problem for the divisible sandpile. See the module docstring for
`f ≥ 0` on `ℤ^d` versus on `V̄`. -/
def divLeastActionSet (V : Set (Site d)) (η : Site d → ℝ) : Set (Site d → ℝ) :=
  {f | (∀ x, 0 ≤ f x) ∧ ∀ x ∈ V, lapR f x + η x ≤ 1}

/-- The pointwise infimum `min{f ≥ 0 : Δ_{ℤ^d} f + η ≤ 1 in V}` of Proposition 8.1.
It is `0` when the class is empty (`Real.iInf_of_isEmpty`); the class is bounded below by `0`. -/
def divLeastAction (V : Set (Site d)) (η : Site d → ℝ) (x : Site d) : ℝ :=
  ⨅ f : divLeastActionSet V η, (f : Site d → ℝ) x

/-- If the class has a least element `v`, the pointwise infimum is `v`. -/
theorem divLeastAction_eq_of_isLeast {V : Set (Site d)} {η : Site d → ℝ} {v : Site d → ℝ}
    (hv : IsLeast (divLeastActionSet V η) v) : divLeastAction V η = v := by
  funext x
  haveI : Nonempty (divLeastActionSet V η) := ⟨⟨v, hv.1⟩⟩
  refine le_antisymm (ciInf_le ⟨0, ?_⟩ (⟨v, hv.1⟩ : divLeastActionSet V η)) ?_
  · rintro _ ⟨f, rfl⟩
    exact f.2.1 x
  · exact le_ciInf fun f => hv.2 f.2 x

/-! ### The odometers of Theorem 8.2 and their rescaling -/

/-- `v_n`, the odometer of the divisible sandpile initialized according to `η` in
`W_n = ℤ^d ∩ nW` (`discretize W n`). -/
def divOdometerDomain (W : Set (Rd d)) (n : ℕ) (η : Site d → ℝ) : Site d → ℝ :=
  divOdometer (discretize W n) η

/-- `v_{avg_n}`, the odometer of the averaged divisible sandpile `η ≡ m` in `W_n`;
the paper takes `m = η_avg = E η(0)` (`meanEtaReal`). -/
def divOdometerAvg (W : Set (Rd d)) (n : ℕ) (m : ℝ) : Site d → ℝ :=
  divOdometer (discretize W n) fun _ => m

/-- The rescaled divisible odometer `v̄(x) = n⁻² v([nx])`, with `[·]` the coordinatewise
floor `latticeRound` (on the set `n⁻¹ W̄_n` of Theorem 8.2, `nx` is a lattice point and
`[nx] = nx`, `latticeRound_smul_inv_smul_toE`). -/
def rescaleDivOdo (v : Site d → ℝ) (n : ℕ) : Rd d → ℝ :=
  fun x => v (latticeRound ((n : ℝ) • x)) / (n : ℝ) ^ 2

/-- The rescaled discrete closure `n⁻¹ W̄_n = {n⁻¹ z : z ∈ W_n ∪ ∂W_n} ⊆ ℝ^d`, the set
over which Theorem 8.2 takes its supremum. -/
def rescaledDClosure (W : Set (Rd d)) (n : ℕ) : Set (Rd d) :=
  (fun z : Site d => (n : ℝ)⁻¹ • toE z) '' dClosure (discretize W n)

theorem latticeRound_toE (z : Site d) : latticeRound (toE z) = z := by
  funext i
  simp [latticeRound]

theorem latticeRound_smul_inv_smul_toE {n : ℕ} (hn : n ≠ 0) (z : Site d) :
    latticeRound ((n : ℝ) • ((n : ℝ)⁻¹ • toE z)) = z := by
  rw [smul_smul, mul_inv_cancel₀ (Nat.cast_ne_zero.mpr hn), one_smul, latticeRound_toE]

end RandomSandpile
