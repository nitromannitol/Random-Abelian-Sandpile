import Mathlib

/-!
# Comparator challenge: the recurrent single-source theorem (Theorem 9.2, corrected)

Mathlib-only statement audit for A. Bou-Rabee, *Convergence of the random Abelian sandpile*,
Ann. Probab. 49 (2021), in the corrected form of `paper/random_piles-corrected.tex`, Theorem 9.2
(correction C13).

This file imports only `Mathlib`: no repository module and no dependency. It restates from
Mathlib every definition that the statement unfolds to, so that the statement can be checked from
this file alone. The library statement is `RandomSandpile.SingleSourceTheoremRecurrentStmt`
(`RandomSandpile/Draft/Section9Recurrent.lean`), proved as
`RandomSandpile.singleSourceTheoremRecurrent_final`.

The statement: for every dimension `d ≥ 2` and every random environment `E` on `ℤ^d` with
`η_max ≤ 2d - 2`, there is a least element `v` of the recurrent obstacle class such that for
`P`-almost every background `η`, the rescaled odometer of `η + n δ_0` converges to `v + G`
locally uniformly away from the origin, where `G` is the fundamental solution of the Laplacian
(`ΔG = -δ_0`). The two cited results enter as hypotheses: the Fey–Levine–Peres radius bound and
Alexandrov's theorem.

The vocabulary between `VOCABULARY-BEGIN` and `VOCABULARY-END` is copied verbatim into
`RandomSandpileAudit/SingleSource/SolutionBasic.lean`; the two blocks must stay byte-identical.
The one intentional statement-level gap is the proof of the final theorem below.
-/

open MeasureTheory Filter Topology Asymptotics
open scoped ENNReal Matrix

namespace RandomSandpile
namespace StatementAudit
namespace SingleSource

-- VOCABULARY-BEGIN
noncomputable section

/-! ## Sites, unit vectors and the nearest-neighbour graph (`LatticeProb/Site.lean`) -/

/-- A site of the lattice `ℤ^d`. -/
abbrev Site (d : ℕ) : Type := Fin d → ℤ

/-- The continuum `ℝ^d`, with the Euclidean norm and Lebesgue measure. -/
abbrev Rd (d : ℕ) : Type := EuclideanSpace ℝ (Fin d)

/-- The unit vector `e_i` in direction `i`. -/
def unit {d : ℕ} (i : Fin d) : Site d := Pi.single i 1

/-- A unit vector is not zero. -/
theorem unit_ne_zero {d : ℕ} (i : Fin d) : unit i ≠ 0 := by
  intro h
  have := congrFun h i
  simp [unit, Pi.single_eq_same] at this

/-- The nearest-neighbour lattice on `ℤ^d`: `y ∼ x` when `y = x ± e_i` for some direction `i`. -/
def lattice (d : ℕ) : SimpleGraph (Site d) where
  Adj x y := ∃ i : Fin d, y = x + unit i ∨ x = y + unit i
  symm := ⟨fun _ _ h => h.imp fun _ hi => hi.symm⟩
  loopless := ⟨fun x h => by
    obtain ⟨i, hi | hi⟩ := h
    · exact unit_ne_zero i (by have := congrArg (· - x) hi; simpa using this.symm)
    · exact unit_ne_zero i (by have := congrArg (· - x) hi; simpa using this.symm)⟩

/-- The embedding `ℤ^d ⊂ ℝ^d`. -/
def toE {d : ℕ} (x : Site d) : Rd d := WithLp.toLp 2 (fun i => (x i : ℝ))

/-- The lattice ball `B_r(x) = {y ∈ ℤ^d : |y - x|_2 < r}`. -/
def ballZ {d : ℕ} (x : Site d) (r : ℝ) : Set (Site d) := {y | ‖toE y - toE x‖ < r}

/-- The lattice ball `B_r = B_r(0)`. -/
def ballZ0 {d : ℕ} (r : ℝ) : Set (Site d) := ballZ 0 r

/-! ## Unit topplings, the integer Laplacian and boundaries (`LatticeProb/Sandpile/Toppling.lean`,
`LatticeProb/Graph/Boundary.lean`, `RandomSandpile/Defs/Lattice.lean`) -/

/-- The unit mass `δ_z` at the site `z`. -/
def dirac {d : ℕ} (z : Site d) : Site d → ℤ := fun x => if x = z then 1 else 0

/-- The sum of `u` over the `2d` neighbours of `x`, direction by direction. -/
def nbrSumZ {d : ℕ} (u : Site d → ℤ) (x : Site d) : ℤ :=
  ∑ i : Fin d, (u (x + unit i) + u (x - unit i))

/-- The integer discrete Laplacian `Δ_{ℤ^d} u(x) = ∑_{y ∼ x} (u(y) - u(x))`. -/
def lap {d : ℕ} (u : Site d → ℤ) (x : Site d) : ℤ := nbrSumZ u x - 2 * d * u x

/-- The outer boundary `∂A`: the vertices outside `A` adjacent to a vertex of `A` in `G`. -/
def outerBoundary {V : Type*} (G : SimpleGraph V) (A : Set V) : Set V :=
  {x | x ∉ A ∧ ∃ y ∈ A, G.Adj x y}

/-- The closure `Ā = A ∪ ∂A` in the graph `G`. -/
def closureN {V : Type*} (G : SimpleGraph V) (A : Set V) : Set V := A ∪ outerBoundary G A

/-- The discrete boundary `∂A = {y ∈ ℤ^d ∖ A : ∃ x ∈ A, y ∼ x}` (tex 161-164). -/
def bdry {d : ℕ} (A : Set (Site d)) : Set (Site d) := outerBoundary (lattice d) A

/-- The discrete closure `Ā = A ∪ ∂A` (tex 165-168). -/
def dClosure {d : ℕ} (A : Set (Site d)) : Set (Site d) := closureN (lattice d) A

/-! ## Random environments (Section 1.2, `RandomSandpile/Defs/Environment.lean`) -/

/-- A background `η : ℤ^d → ℤ`, with the product σ-algebra generated by the coordinates. -/
abbrev Config (d : ℕ) : Type := Site d → ℤ

/-- The translation `T_y η(z) = η(y + z)`. -/
def shift {d : ℕ} (y : Site d) (η : Config d) : Config d := fun z => η (y + z)

/-- A random environment (tex 205-224): a probability measure `P` on backgrounds which is
uniformly bounded between `η_min` and `η_max`, stationary under every translation `T_y`, and
ergodic. -/
structure RandomEnvironment (d : ℕ) where
  /-- The law `P` of the background. -/
  P : Measure (Config d)
  /-- `P` is a probability measure. -/
  [isProb : IsProbabilityMeasure P]
  /-- The lower bound `η_min`. -/
  ηmin : ℤ
  /-- The upper bound `η_max`. -/
  ηmax : ℤ
  /-- `η_min ≤ η(x) ≤ η_max` for every site `x`, almost surely. -/
  bounded : ∀ x : Site d, ∀ᵐ η ∂P, ηmin ≤ η x ∧ η x ≤ ηmax
  /-- Stationarity: `P(T_y E) = P(E)`, that is, every translation `T_y` preserves `P`. -/
  stationary : ∀ y : Site d, MeasurePreserving (shift y) P P
  /-- Ergodicity: a translation-invariant event has probability `0` or `1`. -/
  ergodic : ∀ S : Set (Config d), MeasurableSet S → (∀ y : Site d, shift y ⁻¹' S = S) →
    P S = 0 ∨ P S = 1

attribute [instance] RandomEnvironment.isProb

/-! ## Toppling functions, stabilizing topplings and odometers (Section 2, Section 9;
`RandomSandpile/Defs/Toppling.lean`, `RandomSandpile/Defs/Odometer.lean`) -/

/-- `u` is a toppling function on `Ā`: nonnegative, and vanishing off the discrete closure `Ā`. -/
def IsTopplingFn {d : ℕ} (A : Set (Site d)) (u : Site d → ℤ) : Prop :=
  (∀ x, 0 ≤ u x) ∧ ∀ x ∉ dClosure A, u x = 0

/-- The stabilizing topplings `𝓢(η, A)` (tex 250-252): toppling functions `v` on `Ā` with
`Δ_{ℤ^d} v + η ≤ 2d - 1` in `A`. -/
def stabilizing {d : ℕ} (η : Site d → ℤ) (A : Set (Site d)) : Set (Site d → ℤ) :=
  {v | IsTopplingFn A v ∧ ∀ x ∈ A, lap v x + η x ≤ 2 * (d : ℤ) - 1}

/-- The pointwise infimum `x ↦ inf {u(x) : u ∈ S}` of a set `S` of nonnegative integer functions,
computed in `ℕ`. For a nonempty class of stabilizing topplings it is the least element of the
class. -/
def pointwiseInf {d : ℕ} (S : Set (Site d → ℤ)) : Site d → ℤ :=
  fun x => ((sInf {n : ℕ | ∃ u ∈ S, u x = n} : ℕ) : ℤ)

/-- The odometer of the background `η + m δ_0` on all of `ℤ^d` (tex 1610-1614): the pointwise
least stabilizing toppling function of `η + m δ_0`. -/
def singleSourceOdometer {d : ℕ} (η : Site d → ℤ) (m : ℕ) : Site d → ℤ :=
  pointwiseInf (stabilizing (fun x => η x + (m : ℤ) * dirac 0 x) Set.univ)

/-- The coordinatewise floor `[x]_i = ⌊x_i⌋` of a point `x ∈ ℝ^d` (tex 98). -/
def latticeRound {d : ℕ} (x : Rd d) : Site d := fun i => ⌊x i⌋

/-- The single-source rescaling `v̄_n(x) = n^{-2/d} v_n([n^{1/d} x])` (tex 1616). -/
def rescaleSingleSource {d : ℕ} (v : Site d → ℤ) (n : ℕ) : Rd d → ℝ :=
  fun x => (n : ℝ) ^ (-(2 / (d : ℝ))) * (v (latticeRound ((n : ℝ) ^ (1 / (d : ℝ)) • x)) : ℝ)

/-! ## The fundamental solution (`RandomSandpile/Defs/Obstacle.lean`) -/

/-- The volume `ω_d = |B_1|` of the unit ball of `ℝ^d`. -/
def unitBallVolume (d : ℕ) : ℝ := (volume (Metric.ball (0 : Rd d) 1)).toReal

/-- The fundamental solution `G` of the Laplacian with `ΔG = -δ_0` (Theorem 9.2, tex 1616):
`G(x) = -(1/2π) log|x|` for `d = 2`, and `G(x) = |x|^{2-d} / (d (d-2) ω_d)` otherwise. -/
def fundamentalSolution (d : ℕ) (x : Rd d) : ℝ :=
  if d = 2 then -(1 / (2 * Real.pi)) * Real.log ‖x‖
  else ‖x‖ ^ (2 - (d : ℝ)) / ((d : ℝ) * ((d : ℝ) - 2) * unitBallVolume d)

/-! ## Quadratics and gradient sets (tex 159, 427-440; `RandomSandpile/Defs/Lattice.lean`) -/

/-- The quadratic `q_M(x) = ½ xᵀ M x` on `ℝ^d`. -/
def qM {d : ℕ} (M : Matrix (Fin d) (Fin d) ℝ) (x : Rd d) : ℝ :=
  (1 / 2 : ℝ) * (WithLp.ofLp x ⬝ᵥ M *ᵥ WithLp.ofLp x)

/-- The quadratic `q_l(x) = l |x|² / (2d)` on `ℝ^d`. -/
def ql {d : ℕ} (l : ℝ) (x : Rd d) : ℝ := l * ‖x‖ ^ 2 / (2 * d)

/-- `q_M` restricted to the lattice. -/
def qMZ {d : ℕ} (M : Matrix (Fin d) (Fin d) ℝ) (x : Site d) : ℝ := qM M (toE x)

/-- `q_l` restricted to the lattice. -/
def qlZ {d : ℕ} (l : ℝ) (x : Site d) : ℝ := ql l (toE x)

/-- The supergradient set `∂⁺(v, x, A) = {p : v(x) + p·(y - x) ≥ v(y) for all y ∈ Ā}`. -/
def supGrad {d : ℕ} (v : Site d → ℝ) (x : Site d) (A : Set (Site d)) : Set (Rd d) :=
  {p | ∀ y ∈ dClosure A, v y ≤ v x + inner ℝ p (toE y - toE x)}

/-- The subgradient set `∂⁻(v, x, A) = {p : v(x) + p·(y - x) ≤ v(y) for all y ∈ Ā}`. -/
def subGrad {d : ℕ} (v : Site d → ℝ) (x : Site d) (A : Set (Site d)) : Set (Rd d) :=
  {p | ∀ y ∈ dClosure A, v x + inner ℝ p (toE y - toE x) ≤ v y}

/-- `∂⁺(v, A) = ⋃_{x ∈ A} ∂⁺(v, x, A)`. -/
def supGradSet {d : ℕ} (v : Site d → ℝ) (A : Set (Site d)) : Set (Rd d) :=
  ⋃ x ∈ A, supGrad v x A

/-- `∂⁻(v, A) = ⋃_{x ∈ A} ∂⁻(v, x, A)`. -/
def subGradSet {d : ℕ} (v : Site d → ℝ) (A : Set (Site d)) : Set (Rd d) :=
  ⋃ x ∈ A, subGrad v x A

/-! ## Recurrent functions and the recurrent effective operator (Section 9;
`RandomSandpile/Defs/Recurrent.lean`) -/

/-- `r` is a recurrent function on `A` for the background `η`: a signed stabilizing function with
the local comparison property of tex 1600-1612, tested on finite subsets `E ⊆ A`. -/
def IsRecurrentFunction {d : ℕ} (η : Site d → ℤ) (A : Set (Site d)) (r : Site d → ℤ) : Prop :=
  (∀ x ∈ A, lap r x + η x ≤ 2 * (d : ℤ) - 1) ∧
  ∀ E : Set (Site d), E.Finite → E.Nonempty → E ⊆ A →
    ∀ w : Site d → ℤ, (∀ x ∈ E, lap w x + η x ≤ 2 * (d : ℤ) - 1) →
      ∀ x ∈ E, ∃ y ∈ bdry E, r x - w x ≤ r y - w y

/-- The recurrent perturbations `r - (q_l + q_M)` of the recurrent functions on `A`. -/
def recurrentPerturbed {d : ℕ} (A : Set (Site d)) (η : Site d → ℤ) (l : ℝ)
    (M : Matrix (Fin d) (Fin d) ℝ) : Set (Site d → ℝ) :=
  (fun r x => (r x : ℝ) - (qlZ l x + qMZ M x)) '' {r | IsRecurrentFunction η A r}

/-- The recurrent upper gradient measure: the supremum over recurrent perturbations of the volume
of the supergradient set. -/
noncomputable def muRecurrent {d : ℕ} (A : Set (Site d)) (η : Site d → ℤ) (l : ℝ)
    (M : Matrix (Fin d) (Fin d) ℝ) : ℝ≥0∞ :=
  ⨆ w ∈ recurrentPerturbed A η l M, volume (supGradSet w A)

/-- The recurrent lower gradient measure: the supremum over recurrent perturbations of the volume
of the subgradient set. Signed functions are allowed. -/
noncomputable def muStarRecurrent {d : ℕ} (A : Set (Site d)) (η : Site d → ℤ) (l : ℝ)
    (M : Matrix (Fin d) (Fin d) ℝ) : ℝ≥0∞ :=
  ⨆ w ∈ recurrentPerturbed A η l M, volume (subGradSet w A)

/-- The deterministic recurrent upper density `μ_rec(l, M)`: the `P`-average of the `limsup` of the
normalized recurrent gradient measure over the balls `B_n`. -/
noncomputable def muRecurrentBar {d : ℕ} (E : RandomEnvironment d) (l : ℝ)
    (M : Matrix (Fin d) (Fin d) ℝ) : ℝ :=
  (∫⁻ η, limsup (fun n : ℕ => muRecurrent (ballZ0 (n : ℝ)) η l M /
    ((ballZ0 (d := d) (n : ℝ)).ncard : ℝ≥0∞)) atTop ∂E.P).toReal

/-- The deterministic recurrent lower density `μ*_rec(l, M)`. -/
noncomputable def muStarRecurrentBar {d : ℕ} (E : RandomEnvironment d) (l : ℝ)
    (M : Matrix (Fin d) (Fin d) ℝ) : ℝ :=
  (∫⁻ η, limsup (fun n : ℕ => muStarRecurrent (ballZ0 (n : ℝ)) η l M /
    ((ballZ0 (d := d) (n : ℝ)).ncard : ℝ≥0∞)) atTop ∂E.P).toReal

/-- The recurrent effective operator `F̄_rec(M)`: the supremum of the levels `l` at which both
recurrent densities vanish. -/
noncomputable def effOpRecurrent {d : ℕ} (E : RandomEnvironment d)
    (M : Matrix (Fin d) (Fin d) ℝ) : ℝ :=
  sSup {l : ℝ | muRecurrentBar E l M = 0 ∧ muStarRecurrentBar E l M = 0}

/-! ## Viscosity test functions and second-order Taylor expansions (Section 7 and 9;
`RandomSandpile/Defs/Viscosity.lean`) -/

/-- The Hessian matrix `D²φ(x)`, with entries `D²φ(x)(eᵢ, eⱼ)`. -/
def hessian {d : ℕ} (φ : Rd d → ℝ) (x : Rd d) : Matrix (Fin d) (Fin d) ℝ :=
  Matrix.of fun i j =>
    fderiv ℝ (fderiv ℝ φ) x (EuclideanSpace.single i 1) (EuclideanSpace.single j 1)

/-- The second-order Taylor expansion with Peano remainder at `a`, with gradient `p` and matrix
`X`: `u(x) = u(a) + p·(x-a) + ½(x-a)ᵀX(x-a) + o(|x-a|²)` as `x → a`. -/
def HasSecondOrderTaylorAt {d : ℕ} (u : Rd d → ℝ) (a p : Rd d)
    (X : Matrix (Fin d) (Fin d) ℝ) : Prop :=
  (fun x => u x - u a - inner ℝ p (x - a) - qM X (x - a)) =o[𝓝 a] fun x => ‖x - a‖ ^ 2

/-- `F(D²u) ≥ 0` in `U`, tested from below: at every `x ∈ U` and every `C²` function `φ` such
that `u - φ` has a local minimum at `x`, `0 ≤ F(D²φ(x))` (Crandall–Ishii–Lions). -/
def ViscFromBelowGE {d : ℕ} (F : Matrix (Fin d) (Fin d) ℝ → ℝ) (U : Set (Rd d))
    (u : Rd d → ℝ) : Prop :=
  ∀ x ∈ U, ∀ φ : Rd d → ℝ, ContDiffAt ℝ 2 φ x → IsLocalMin (fun y => u y - φ y) x →
    0 ≤ F (hessian φ x)

/-! ## The recurrent obstacle class and its conclusion (Section 9;
`RandomSandpile/Draft/Section9Recurrent.lean`) -/

/-- The recurrent single-source obstacle class: continuous `v` with `v + G ≥ 0` away from the
origin and `F̄_rec(D²(v + G)) ≥ 0` in the viscosity-supersolution sense on `ℝ^d ∖ {0}`. -/
def recurrentSingleSourceObstacleSet {d : ℕ} (E : RandomEnvironment d) : Set (Rd d → ℝ) :=
  {v | Continuous v ∧ (∀ x : Rd d, x ≠ 0 → 0 ≤ v x + fundamentalSolution d x) ∧
    ViscFromBelowGE (effOpRecurrent E) {x : Rd d | x ≠ 0}
      (fun x => v x + fundamentalSolution d x)}

/-- The background `η` is finite: every single-source background `η + n δ_0` admits a stabilizing
toppling function, for every `n`. -/
def SingleSourceFinite {d : ℕ} (η : Site d → ℤ) : Prop :=
  ∀ n : ℕ, (stabilizing (fun x => η x + (n : ℤ) * dirac 0 x) Set.univ).Nonempty

/-- The conclusion of the recurrent single-source theorem for the environment `E`: a least element
`v` of the recurrent obstacle class such that, for `P`-almost every background `η`, the odometers
of `η + n δ_0`, rescaled by `n^{-2/d}`, converge to `v + G` locally uniformly away from the origin.
-/
def SingleSourceRecurrentConclusion {d : ℕ} (E : RandomEnvironment d) : Prop :=
  ∃ v : Rd d → ℝ, IsLeast (recurrentSingleSourceObstacleSet E) v ∧
    ∀ᵐ η ∂E.P, SingleSourceFinite η ∧
      TendstoLocallyUniformlyOn
        (fun n : ℕ => rescaleSingleSource (singleSourceOdometer η n) n)
        (fun x => v x + fundamentalSolution d x) atTop {x : Rd d | x ≠ 0}

/-! ## The literature inputs taken as hypotheses (`LatticeProb/External/FeyLevinePeresRadius.lean`,
`RandomSandpile/Inputs/Alexandrov.lean`) -/

/-- The parallel toppling odometer `v_t` of the initial sandpile `s₀`: `v_0 = 0` and
`v_{t+1} = v_t + 1{s_t ≥ 2d}`, where `s_t = s₀ + Δv_t`. -/
def podo {d : ℕ} (s0 : Site d → ℤ) : ℕ → Site d → ℤ
  | 0 => fun _ => 0
  | t + 1 => fun x =>
      podo s0 t x + (if 2 * d ≤ s0 x + lap (podo s0 t) x then 1 else 0)

/-- **Input (Fey, Levine and Peres, Theorem 1.1).** For `d ≤ h ≤ 2d - 2`, `ε > 0` and `n` large,
the sites that topple from `h + n δ_0` lie in the cube of radius
`((d + ε) / (2d - 1 - h)) (n / ω_d)^{1/d}`. -/
def FeyLevinePeresRadius : Prop :=
  ∀ d : ℕ, ∀ h : ℤ, (d : ℤ) ≤ h → h ≤ 2 * (d : ℤ) - 2 →
    ∀ ε : ℝ, 0 < ε →
      ∃ n0 : ℕ, ∀ n : ℕ, n0 ≤ n →
        {x : Site d | ∃ t : ℕ, 0 < podo (fun y : Site d => h + (n : ℤ) * dirac (0 : Site d) y) t x} ⊆
          {x : Site d | ∀ i : Fin d, |(x i : ℝ)| ≤
            (((d : ℝ) + ε) / (2 * (d : ℝ) - 1 - (h : ℝ))) *
              (((n : ℝ) / (volume (Metric.ball (0 : EuclideanSpace ℝ (Fin d)) 1)).toReal) ^
                (1 / (d : ℝ)))}

/-- **Input IR9 (Alexandrov's theorem).** Every convex `f : ℝ^d → ℝ` has, at Lebesgue-almost
every point, a second-order Taylor expansion with a symmetric matrix. -/
def AlexandrovStmt : Prop :=
  ∀ (d : ℕ) (f : Rd d → ℝ), ConvexOn ℝ Set.univ f →
    ∀ᵐ x ∂(volume : Measure (Rd d)), ∃ (p : Rd d) (X : Matrix (Fin d) (Fin d) ℝ),
      X.IsSymm ∧ HasSecondOrderTaylorAt f x p X

end
-- VOCABULARY-END

/-- **Theorem 9.2 (corrected, C13), recurrent single-source theorem.** Given the Fey–Levine–Peres
radius bound and Alexandrov's theorem, every random environment `E` on `ℤ^d` (`d ≥ 2`) with
`η_max ≤ 2d - 2` satisfies `SingleSourceRecurrentConclusion`. -/
theorem singleSourceRecurrent (hFLP : FeyLevinePeresRadius) (hA : AlexandrovStmt) :
    ∀ (d : ℕ), 2 ≤ d → ∀ E : RandomEnvironment d,
      E.ηmax ≤ 2 * (d : ℤ) - 2 → SingleSourceRecurrentConclusion E := sorry

end SingleSource
end StatementAudit
end RandomSandpile
